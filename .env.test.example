# Copia in .env.test.local per override locali (opzionale).
# I test non creano utenti, campagne o contenuti persistenti.

PLAYWRIGHT_PORT=3099
PLAYWRIGHT_BASE_URL=http://localhost:3099

# Produzione: npm run test:e2e:prod
# I progetti autenticati richiedono un file locale esplicito:
# tests/e2e/.auth/credentials.json (ignorato da Git).
