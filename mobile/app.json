{
  "expo": {
    "name": "Barber & Dragons Mobile",
    "slug": "barber-and-dragons-mobile",
    "scheme": "com.barberanddragons.mobile",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.barberanddragons.mobile",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Barber & Dragons non consulta la libreria foto. Per leggere i codici QR del Telecomando GM usa la fotocamera."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0908"
      },
      "userInterfaceStyle": "dark",
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.barberanddragons.mobile",
      "versionCode": 12,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/with-xcode-project",
      "expo-apple-authentication",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Consenti a Barber & Dragons di usare il microfono per dettare comandi al GM Screen.",
          "speechRecognitionPermission": "Consenti a Barber & Dragons di trascrivere la dettatura per il GM Screen.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Consenti a Barber & Dragons di utilizzare la fotocamera per scansionare il QR code del Telecomando."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0908"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "20cc1c5a-482a-49fd-bf41-cb5f86592eb7"
      }
    },
    "owner": "alexiit33"
  }
}
